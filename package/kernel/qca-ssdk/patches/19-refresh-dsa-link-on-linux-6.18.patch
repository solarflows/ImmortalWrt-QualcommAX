-#ifdef MP
+		case NETDEV_UP:
+#if IS_ENABLED(CONFIG_NET_DSA) && (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+			ssdk_dsa_netdev_link_refresh(dev);
+#endif
+			break;
 		case NETDEV_CHANGE:
+#if IS_ENABLED(CONFIG_NET_DSA) && (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+			ssdk_dsa_netdev_link_refresh(dev);
+#endif
+#ifdef MP
 			if ((cfg.chip_type == CHIP_SCOMPHY) &&
 				(cfg.phy_id == MP_GEPHY)) {
 				if ((p_api == NULL) || (p_api->adpt_port_netdev_notify_set == NULL)
@@ -1774,11 +1876,17 @@ static int ssdk_dev_event(struct notifie
 					}
 				}
 			}
-			break;
 #endif
+			break;
 		case NETDEV_REGISTER:
+#if IS_ENABLED(CONFIG_NET_DSA) && (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+			if (ssdk_netdev_switch_init_required(dev) == A_TRUE)
+				ssdk_netdev_switch_init(dev);
+			ssdk_dsa_netdev_link_refresh(dev);
+#else
 			if (strstr(dev->name, "eth") && !(dev->priv_flags & IFF_802_1Q_VLAN))
 				ssdk_netdev_switch_init(dev);
+#endif
 			break;
 	}
 
