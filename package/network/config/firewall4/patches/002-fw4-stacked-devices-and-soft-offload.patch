From: Julius Bairaktaris <julius@bairaktaris.de>
Subject: [PATCH] firewall4: list stacked devices and layer 3 interfaces for flow offloading

With generic flowtable ending the forward path at a device with tc, a flow
ends at the first device of its forward path that has a qdisc or a tc hook,
so that an SQM shaper on a VLAN or PPPoE WAN still sees it. The kernel offloads
the flow only if that device is a flowtable device.

List the bridges and VLANs themselves next to their lower devices. Also list
the layer 3 devices of zones (such as WireGuard interfaces) so their flows can
be offloaded via software flowtable instead of falling back to slow path.

Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -447,6 +447,8 @@ function resolve_lower_devices(devstatus, devname) {
 		case 'vlan':
 		case 'bridge':
 			let e;
+
+			push(devs, devname);
 
 			while ((e = dir.read()) != null)
 				if (index(e, "lower_") === 0)
@@ -532,9 +534,23 @@ return {
 			bus.disconnect();
 		}
 
+		// the zone devices with the devices below them, and the layer 3
+		// device of each zone network, such as a WireGuard interface; a
+		// flow ends at the first device of its path that runs tc, such as
+		// an SQM shaper on a VLAN, so the stacked devices are listed too
+		let related = [];
+
 		for (let zone in this.zones())
-			for (let device in zone.related_physdevs)
-				push(devices ||= [], ...resolve_lower_devices(devstatus, device));
+			push(related, ...zone.related_physdevs, ...zone.related_l3devs);
+
+		for (let device in uniq(related))
+			push(devices ||= [], ...resolve_lower_devices(devstatus, device));
+
+		// devices a zone names directly, such as a bridge of a container runtime
+		for (let zone in this.zones())
+			for (let device in zone.match_devices)
+				if (!device.is_wildcard)
+					push(devices ||= [], ...resolve_lower_devices(devstatus, device.device));
 
 		if (!devices)
 			return null;
@@ -560,10 +576,26 @@ return {
 		if (!devices) {
 			devices = [];
 
+			let devstatus = null;
+			let bus = ubus.connect();
+
+			if (bus) {
+				devstatus = bus.call("network.device", "status") || {};
+				bus.disconnect();
+			}
+
+			let related = [];
+
 			for (let zone in this.zones())
-				for (let device in zone.related_physdevs)
-					if (fs.access(`/sys/class/net/${device}`))
-						push(devices, device);
+				push(related, ...zone.related_physdevs, ...zone.related_l3devs);
+
+			for (let device in uniq(related))
+				push(devices, ...resolve_lower_devices(devstatus, device));
+
+			for (let zone in this.zones())
+				for (let device in zone.match_devices)
+					if (!device.is_wildcard)
+						push(devices, ...resolve_lower_devices(devstatus, device.device));
 
 			devices = sort(uniq(devices));
 		}
@@ -2140,6 +2172,7 @@ return {
 
 		let match_devices = [];
 		let related_physdevs = [];
+		let related_l3devs = [];
 		let related_subnets = [];
 		let related_ubus_networks = [];
 		let match_subnets, masq_src_subnets, masq_dest_subnets;
@@ -2165,6 +2198,9 @@ return {
 				if (net.physdev && !e.invert)
 					push(related_physdevs, net.physdev);
 
+				if (net.device && net.device != net.physdev && !e.invert)
+					push(related_l3devs, net.device);
+
 				push(related_subnets, ...(net.ipaddrs || []));
 			}
 		}
@@ -2298,6 +2334,7 @@ return {
 
 		zone.related_subnets = related_subnets;
 		zone.related_physdevs = related_physdevs;
+		zone.related_l3devs = related_l3devs;
 
 		if (zone.masq || zone.masq6)
 			zone.dflags.snat = true;
