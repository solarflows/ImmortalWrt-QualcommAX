+#if IS_ENABLED(CONFIG_NET_DSA) && (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0))
+static a_bool_t ssdk_netdev_is_nss_dp(struct net_device *dev)
+{
+	struct device_node *np = NULL;
+
+	if (!dev || (dev->priv_flags & IFF_802_1Q_VLAN))
+		return A_FALSE;
+
+	np = dev->dev.of_node;
+	if (!np && dev->dev.parent)
+		np = dev->dev.parent->of_node;
+
+	if (np && of_device_is_compatible(np, "qcom,nss-dp"))
+		return A_TRUE;
+
+	return A_FALSE;
+}
+
+static a_bool_t ssdk_netdev_switch_init_required(struct net_device *dev)
+{
+	if (!dev || (dev->priv_flags & IFF_802_1Q_VLAN))
+		return A_FALSE;
+
+	if (strstr(dev->name, "eth"))
+		return A_TRUE;
+
+	return ssdk_netdev_is_nss_dp(dev);
+}
+
+static ssdk_netdev_switch_t *ssdk_netdev_switch_find_or_init(struct net_device *dev)
+{
+	ssdk_netdev_switch_t *netdev_switch = NULL;
+
+	netdev_switch = ssdk_dts_netdev_switch_find_by_netdev(dev);
+	if (netdev_switch)
+		return netdev_switch;
+
+	if (ssdk_netdev_switch_init_required(dev) != A_TRUE)
+		return NULL;
+
+	ssdk_netdev_switch_init(dev);
+
+	return ssdk_dts_netdev_switch_find_by_netdev(dev);
+}
+
+static void ssdk_dsa_netdev_link_refresh(struct net_device *dev)
+{
+	ssdk_netdev_switch_t *netdev_switch = NULL;
+	struct qca_phy_priv* priv = NULL;
+	struct net_device *conduit = NULL;
+	struct dsa_port *dp = NULL;
+
+	netdev_switch = ssdk_netdev_switch_find_or_init(dev);
+	if (!netdev_switch) {
+		dp = dsa_port_from_netdev(dev);
+		if (IS_ERR_OR_NULL(dp) || !dp->cpu_dp)
+			return;
+
+		conduit = dsa_port_to_conduit(dp);
+		if (!conduit)
+			return;
+
+		netdev_switch = ssdk_netdev_switch_find_or_init(conduit);
+	}
+
+	if (!netdev_switch)
+		return;
+
+	priv = ssdk_phy_priv_data_get(netdev_switch->switch_dev_id);
+	if (!priv)
+		return;
+
+	switch (priv->version) {
+	case QCA_VER_HPPE:
+	case QCA_VER_APPE:
+	case QCA_VER_MRPPE:
+	case QCA_VER_SCOMPHY:
+		if (priv->link_polling_required)
+			mod_delayed_work(system_wq, &priv->mac_sw_sync_dwork, 0);
+		break;
+	case QCA_VER_MHT:
+	case QCA_VER_AR8337:
+	case QCA_VER_AR8327:
+	case QCA_VER_DESS:
+		priv->polling_once = A_TRUE;
+		mod_delayed_work(system_long_wq, &priv->qm_dwork_polling, 0);
+		break;
+	default:
+		break;
+	}
+}
+#endif
+
