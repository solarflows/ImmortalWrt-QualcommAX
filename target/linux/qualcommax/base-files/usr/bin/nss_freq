#!/bin/sh

clock_dir=/proc/sys/dev/nss/clock
current_freq="$clock_dir/current_freq"
auto_scale="$clock_dir/auto_scale"
compatible=/proc/device-tree/compatible

die() {
	echo "nss_freq: $*" >&2
	exit 1
}

format_frequency() {
	case "$1" in
		''|*[!0-9]*) echo "Unknown" ;;
		*) awk -v hz="$1" 'BEGIN { printf "%.1f MHz", hz / 1000000 }' ;;
	esac
}

show_status() {
	status_current="$(cat "$current_freq" 2>/dev/null | tr -d '[:space:]')"
	if [ -z "$status_current" ]; then
		# Compatibility fallback for kernels without 0004 sysctl fix
		cat "$current_freq" >/dev/null 2>&1
		nss_hz="$(dmesg | grep -o 'Frequency Set to [0-9]*' | tail -n 1 | awk '{print $NF}')"
		[ -n "$nss_hz" ] && status_current="$nss_hz"
	fi
	[ -n "$status_current" ] || die "NSS frequency control is unavailable"
	status_scale="$(cat "$auto_scale" 2>/dev/null | tr -d '[:space:]')" || die "NSS frequency mode is unavailable"
	case "$status_scale" in
		1) status_mode="Auto" ;;
		0) status_mode="Fixed" ;;
		*) status_mode="Unknown" ;;
	esac

	echo "NSS MODE: $status_mode"
	echo "NSS FREQ: $(format_frequency "$status_current")"
}

select_frequencies() {
	[ -r "$compatible" ] || die "device-tree compatible data is unavailable"

	if grep -q 'qcom,ipq6018' "$compatible"; then
		low_frequency=187200000
		mid_frequency=748800000
		high_frequency=1497600000
	elif grep -q 'qcom,ipq8074' "$compatible"; then
		low_frequency=748800000
		mid_frequency=1497600000
		high_frequency=1689600000
	else
		die "unsupported platform"
	fi
}

save_level() {
	[ "$(uci -q get nss_freq.settings.level)" = "$level" ] && return

	uci -q set nss_freq.settings=nss_freq || die "failed to save NSS frequency level"
	uci -q set nss_freq.settings.level="$level" || die "failed to save NSS frequency level"
	uci -q commit nss_freq || die "failed to save NSS frequency level"
}

case "${1:-status}" in
	status)
		show_status
		exit 0
		;;
	low|mid|high)
		level="$1"
		;;
	*[0-9]*)
		req_freq="$1"
		;;
	*)
		echo "Usage: nss_freq {low|mid|high|status|<frequency>}" >&2
		exit 2
		;;
esac

select_frequencies
[ -w "$current_freq" ] || die "run as root after the NSS driver has initialized"

if [ -n "$level" ]; then
	case "$level" in
		low) target_frequency=$low_frequency ;;
		mid) target_frequency=$mid_frequency ;;
		high) target_frequency=$high_frequency ;;
	esac
elif [ -n "$req_freq" ]; then
	case "$req_freq" in
		*748*) level="low"; target_frequency=$low_frequency ;;
		*1497*) level="mid"; target_frequency=$mid_frequency ;;
		*1689*) level="high"; target_frequency=$high_frequency ;;
		*187*) level="low"; target_frequency=$low_frequency ;;
		*)
			target_frequency=$(echo "$req_freq" | tr -cd '0-9')
			level="custom"
			;;
	esac
fi

printf '%s\n' "$target_frequency" > "$current_freq" || die "failed to set NSS frequency"
save_level
echo -n "$(format_frequency "$target_frequency" | tr -d ' ')" > /tmp/nss_freq 2>/dev/null
show_status
