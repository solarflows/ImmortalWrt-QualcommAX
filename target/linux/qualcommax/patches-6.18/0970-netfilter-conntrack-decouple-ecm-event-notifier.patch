+void nf_conntrack_register_ecm_notifier(struct net *net,
+					const struct nf_ct_event_notifier *new)
+{
+	mutex_lock(&nf_ct_ecache_mutex);
+	rcu_assign_pointer(net->ct.nf_conntrack_ecm_cb, new);
+	mutex_unlock(&nf_ct_ecache_mutex);
+}
+EXPORT_SYMBOL_GPL(nf_conntrack_register_ecm_notifier);
+
+void nf_conntrack_unregister_ecm_notifier(struct net *net)
+{
