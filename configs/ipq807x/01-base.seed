# ────────────────────────────────────────────────────────────
# ipq807x (qualcommax) — 基础构建配置
# 此文件包含目标平台、芯片子架构、板级型号及全局编译选项。
# ────────────────────────────────────────────────────────────

# ═══════ 目标平台 ═══════
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_netgear_rbr750=y

# ═══════ NSS 固件与内存画像 ═══════
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

# ═══════ 内核组播与底层硬件调试 ═══════
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y

# ═══════ 构建选项 ═══════
CONFIG_DEVEL=y                     # 开发者模式（保留源码树）
CONFIG_CCACHE=y                    # 编译缓存加速
CONFIG_BUILD_LOG=y                 # 输出编译日志分析
