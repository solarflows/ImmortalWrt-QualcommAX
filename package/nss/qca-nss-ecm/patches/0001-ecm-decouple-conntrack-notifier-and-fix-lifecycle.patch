+			nicsm_req->index = 0;
+		}
 		timed_out = true;
 	}
 	spin_unlock_bh(&ecm_nss_ipv4_lock);
 
 	if (timed_out) {
-		pr_warn_ratelimited("ECM: IPv4 conn stats request unanswered for %u ms, restarting the sync\n",
-				    jiffies_to_msecs(waited));
+		pr_warn_ratelimited("ECM: IPv4 conn stats request unanswered for %u ms (consecutive: %u, next index: %u), backing off\n",
+				    jiffies_to_msecs(waited), ecm_nss_ipv4_consecutive_timeouts, nicsm_req->index);
 	}
 
 	spin_lock_bh(&ecm_nss_ipv4_lock);
@@ -728,24 +743,37 @@ static void ecm_nss_ipv4_stats_sync_req_work(struct work_struct *work)
 	}
 	spin_unlock_bh(&ecm_nss_ipv4_lock);
 
-	msleep_interruptible(ECM_NSS_IPV4_STATS_SYNC_UDELAY / 1000);
+	usleep_range_idle(ECM_NSS_IPV4_STATS_SYNC_UDELAY - 200, ECM_NSS_IPV4_STATS_SYNC_UDELAY);
 
 	/*
-	 * If index is 0, we are starting a new round, but if we still have time remain
-	 * in this round, sleep until it ends
+	 * If index is 0 or we timed out, check next schedule time with exponential backoff.
 	 */
-	if (nicsm_req->index == 0) {
+	spin_lock_bh(&ecm_nss_ipv4_lock);
+	is_round_start = (nicsm_req->index == 0);
+	timeouts = ecm_nss_ipv4_consecutive_timeouts;
+	spin_unlock_bh(&ecm_nss_ipv4_lock);
+
+	if (is_round_start || timeouts) {
+		unsigned long int sync_period = ECM_NSS_IPV4_STATS_SYNC_PERIOD;
+
+		if (timeouts) {
+			int shift = min_t(int, timeouts, 5);
+			sync_period = ECM_NSS_IPV4_STATS_SYNC_PERIOD << shift;
+		}
+
 		current_jiffies = jiffies;
 
-		if (time_is_after_jiffies(ecm_nss_ipv4_roll_check_jiffies))  {
-			ecm_nss_ipv4_next_req_time = jiffies + ECM_NSS_IPV4_STATS_SYNC_PERIOD;
+		if (time_is_after_jiffies(ecm_nss_ipv4_roll_check_jiffies) || timeouts)  {
+			ecm_nss_ipv4_next_req_time = jiffies + sync_period;
 		}
 
 		if (time_after(ecm_nss_ipv4_next_req_time, current_jiffies)) {
-			msleep_interruptible(jiffies_to_msecs(ecm_nss_ipv4_next_req_time - current_jiffies));
+			queue_delayed_work(ecm_nss_ipv4_workqueue, &ecm_nss_ipv4_work,
+					   ecm_nss_ipv4_next_req_time - current_jiffies);
+			return;
 		}
 		ecm_nss_ipv4_roll_check_jiffies = jiffies;
-		ecm_nss_ipv4_next_req_time = ecm_nss_ipv4_roll_check_jiffies + ECM_NSS_IPV4_STATS_SYNC_PERIOD;
+		ecm_nss_ipv4_next_req_time = ecm_nss_ipv4_roll_check_jiffies + sync_period;
 	}
 
 	while (retry) {
