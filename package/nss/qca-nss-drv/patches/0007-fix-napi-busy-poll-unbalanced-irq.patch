From: Mohamed Radwan <mo-radwan1@users.noreply.github.com>
Subject: [PATCH] nss-drv: fix unbalanced enable_irq during NAPI busy poll

All four NAPI poll handlers in qca-nss-drv (nss_core_handle_napi,
nss_core_handle_napi_queue, nss_core_handle_napi_non_queue,
nss_core_handle_napi_sdma) unconditionally call enable_irq() or
nss_hal_enable_interrupt() after napi_complete(). When the kernel's
napi_busy_loop() invokes these poll handlers, the IRQ was never
disabled — busy polling bypasses the normal interrupt->NAPI schedule
path. This triggers kernel warnings ("Unbalanced enable for IRQ").

Replace napi_complete() + unconditional enable_irq() with
napi_complete_done() return value check. napi_complete_done() returns
true when NAPI was in scheduled state (needs re-enabling), and false
during busy polling (skip re-enable).

Signed-off-by: Mohamed Radwan <mo-radwan1@users.noreply.github.com>
---
--- a/nss_core.c
+++ b/nss_core.c
@@ -2578,12 +2578,14 @@ int nss_core_handle_napi(struct napi_struct *napi, int budget)
 	} while ((int_ctx->cause) && (budget));

 	if (int_ctx->cause == 0) {
-		napi_complete(napi);
-
 		/*
-		 * Re-enable any further interrupt from this IRQ
+		 * Re-enable interrupt only if NAPI was in scheduled state.
+		 * napi_complete_done() returns false during busy polling,
+		 * when the IRQ was never disabled.
 		 */
-		nss_hal_enable_interrupt(nss_ctx, int_ctx->shift_factor, NSS_HAL_SUPPORTED_INTERRUPTS);
+		if (napi_complete_done(napi, count)) {
+			nss_hal_enable_interrupt(nss_ctx, int_ctx->shift_factor, NSS_HAL_SUPPORTED_INTERRUPTS);
+		}
 	}

 	return count;
@@ -2618,8 +2620,9 @@ int nss_core_handle_napi_sdma(struct napi_struct *napi, int budget)
 		ctrl->consumer[0].dispatch.fp(ctrl->consumer[0].arg.kp);

 #if !defined(NSS_HAL_IPQ806X_SUPPORT)
-	napi_complete(napi);
-	enable_irq(int_ctx->irq);
+	if (napi_complete_done(napi, 0)) {
+		enable_irq(int_ctx->irq);
+	}
 #endif
 	return 0;
 }
@@ -2635,8 +2638,9 @@ int nss_core_handle_napi_queue(struct napi_struct *napi, int budget)

 	processed = nss_core_handle_cause_queue(int_ctx, int_ctx->cause, budget);
 	if (processed < budget) {
-		napi_complete(napi);
-		enable_irq(int_ctx->irq);
+		if (napi_complete_done(napi, processed)) {
+			enable_irq(int_ctx->irq);
+		}
 	}

 	return processed;
@@ -2651,8 +2655,9 @@ int nss_core_handle_napi_non_queue(struct napi_struct *napi, int budget)
 	struct int_ctx_instance *int_ctx = container_of(napi, struct int_ctx_instance, napi);

 	nss_core_handle_cause_nonqueue(int_ctx, int_ctx->cause, 0);
-	napi_complete(napi);
-	enable_irq(int_ctx->irq);
+	if (napi_complete_done(napi, 0)) {
+		enable_irq(int_ctx->irq);
+	}
 	return 0;
 }
