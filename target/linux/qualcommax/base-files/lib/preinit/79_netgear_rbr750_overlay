#!/bin/sh

prepare_rbr750_overlay() {
	local bname=""
	[ -f /tmp/sysinfo/board_name ] && bname="$(cat /tmp/sysinfo/board_name)"
	[ "$bname" = "netgear,rbr750" ] || return 0

	local mtdnum="" dev size erasesize part
	while read dev size erasesize part; do
		part="${part%\"}"
		part="${part#\"}"
		if [ "$part" = "reserved2" ]; then
			dev="${dev%:}"
			mtdnum="${dev#mtd}"
			break
		fi
	done < /proc/mtd

	[ -n "$mtdnum" ] || return 0

	# Check if an existing UBI device is already attached to reserved2
	local ubidev=""
	for d in /sys/class/ubi/ubi*; do
		[ -d "$d" ] || continue
		if [ "$(cat "$d/mtd_num" 2>/dev/null)" = "$mtdnum" ]; then
			ubidev="$(basename "$d")"
			break
		fi
	done

	# If not attached (e.g. kernel attach failed due to factory header mismatch), format and attach
	if [ -z "$ubidev" ]; then
		if ! ubiattach -m "$mtdnum" 2>/dev/null; then
			echo "Netgear RBR750: Formatting reserved2 (mtd$mtdnum) for rootfs_data..."
			ubiformat "/dev/mtd$mtdnum" -y
			ubiattach -m "$mtdnum"
		fi
		for d in /sys/class/ubi/ubi*; do
			[ -d "$d" ] || continue
			if [ "$(cat "$d/mtd_num" 2>/dev/null)" = "$mtdnum" ]; then
				ubidev="$(basename "$d")"
				break
			fi
		done
	fi

	[ -n "$ubidev" ] || return 0

	# Check if rootfs_data volume exists on this UBI device
	local has_rootfs_data=""
	for vol in /sys/class/ubi/$ubidev/$ubidev"_"*; do
		[ -d "$vol" ] || continue
		if [ "$(cat "$vol/name" 2>/dev/null)" = "rootfs_data" ]; then
			has_rootfs_data="1"
			break
		fi
	done

	# Create rootfs_data volume if missing (first boot)
	if [ -z "$has_rootfs_data" ]; then
		echo "Netgear RBR750: Creating rootfs_data volume on $ubidev..."
		ubimkvol "/dev/$ubidev" -N rootfs_data -m
	fi
}

boot_hook_add preinit_main prepare_rbr750_overlay
